<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="8dp"
    android:gravity="center_vertical" android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/item_icon" android:layout_width="36dp" android:layout_height="36dp"/>
    <TextView android:id="@+id/item_label" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="10dp" android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF"/>
</LinearLayout>
